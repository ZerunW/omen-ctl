+/*
+ * omenctl fan watchdog: once userspace has written omenctl_kick at least once,
+ * if the fans are in manual mode and no kick arrives for omenctl_wd_timeout
+ * seconds, force both fans to the maximum table level. Fails towards cooling.
+ */
+#define OMENCTL_WD_PERIOD_SECS	5
+static unsigned int omenctl_wd_timeout = 15;
+module_param(omenctl_wd_timeout, uint, 0444);
+MODULE_PARM_DESC(omenctl_wd_timeout, "omenctl fan watchdog timeout in seconds (5-60, default 15)");
+
+static struct hp_wmi_hwmon_priv *omenctl_priv;	/* set when fan control is usable */
+
+static unsigned int omenctl_wd_secs(void)
+{
+	return clamp_val(omenctl_wd_timeout, 5, 60);
+}
