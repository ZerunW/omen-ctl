+
+		if (priv) {
+			guard(mutex)(&priv->lock);
+			if (priv->mode == PWM_MODE_AUTO) {
+				err = omenctl_fan_hold_current(priv);
+				if (err)
+					pr_warn("omenctl: failed to hold fan speed: %d\n", err);
+			}
+		}
+	}
+
 	return 0;
 }
 
