+static void omenctl_wd_handler(struct work_struct *work)
+{
+	struct hp_wmi_hwmon_priv *priv;
+	unsigned int secs = omenctl_wd_secs();
+	int ret;
+
+	priv = container_of(to_delayed_work(work), struct hp_wmi_hwmon_priv,
+			    omenctl_wd_dwork);
+
+	scoped_guard(mutex, &priv->lock) {
+		if (priv->omenctl_armed && !priv->omenctl_tripped &&
+		    priv->mode == PWM_MODE_MANUAL &&
+		    time_after(jiffies, priv->omenctl_last_kick + secs_to_jiffies(secs))) {
+			priv->cpu_pwm = U8_MAX;
+			priv->gpu_pwm = U8_MAX;
+			ret = hp_wmi_apply_fan_settings(priv);
+			priv->omenctl_tripped = true;
+			pr_crit("omenctl watchdog: no kick for %us, fans forced to max level (ret %d)\n",
+				secs, ret);
+		}
+	}
+
+	mod_delayed_work(system_dfl_wq, &priv->omenctl_wd_dwork,
+			 secs_to_jiffies(OMENCTL_WD_PERIOD_SECS));
+}
+
+static void omenctl_priv_clear(void *data)
+{
+	WRITE_ONCE(omenctl_priv, NULL);
+}
