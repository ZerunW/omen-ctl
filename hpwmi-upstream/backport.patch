+/*
+ * omenctl (board 8D3F): on this EC a 0x2E fan target of 0 means "stop", not
+ * "automatic". After any 0x10 call the EC runs the fans at the 0x2E targets for
+ * ~120 s, so handing back to BIOS by writing {0,0} stops both fans for 2 minutes.
+ * Instead hold the current measured speed (clamped to the fan table, never 0) and
+ * let the 120 s window expire; the EC then resumes its own curve.
+ */
+static bool omenctl_is_8d3f(void)
+{
+	return dmi_match(DMI_BOARD_NAME, "8D3F");
+}
+
+static int omenctl_fan_hold_current(struct hp_wmi_hwmon_priv *priv)
+{
+	u8 speed[2];
+	int rpm, fan, ret;
+
+	for (fan = 0; fan < 2; fan++) {
+		rpm = hp_wmi_get_active_fan_speed(fan);
+		speed[fan] = rpm < 0 ? priv->max_rpm :
+			     clamp_val(rpm / 100, priv->min_rpm, priv->max_rpm);
+	}
+
+	ret = hp_wmi_fan_speed_max_set(0);
+	if (ret < 0)
+		return ret;
+
+	return hp_wmi_perform_query(HPWMI_VICTUS_S_FAN_SPEED_SET_QUERY, HPWMI_GM,
+				    &speed, sizeof(speed), 0);
+}
