+/*
+ * omenctl addition (board 8D3F only): set the CPU+GPU concurrent power target
+ * used by NVIDIA Dynamic Boost (BIOS GM29 byte 3 -> NPCF.OPAT = W * 8).
+ * Only the value captured from OMEN Gaming Hub's Unleashed log (75 W) is accepted;
+ * PL1/PL2/PL4 bytes are 0xFF (unchanged). Any 0x1A mode switch resets it in BIOS DTPC.
+ */
+#define OMENCTL_CONCURRENT_TDP_W	75
+static ssize_t omenctl_concurrent_tdp_store(struct device *dev,
+					    struct device_attribute *attr,
+					    const char *buf, size_t count)
+{
+	struct victus_power_limits limits;
+	u32 val;
+	int ret;
+
+	if (!dmi_match(DMI_BOARD_NAME, "8D3F"))
+		return -EOPNOTSUPP;
+
+	ret = kstrtou32(buf, 10, &val);
+	if (ret)
+		return ret;
+	if (val != OMENCTL_CONCURRENT_TDP_W)
+		return -EINVAL;
+
+	limits.pl1 = HP_POWER_LIMIT_NO_CHANGE;
+	limits.pl2 = HP_POWER_LIMIT_NO_CHANGE;
+	limits.pl4 = HP_POWER_LIMIT_NO_CHANGE;
+	limits.cpu_gpu_concurrent_limit = OMENCTL_CONCURRENT_TDP_W;
+
+	ret = hp_wmi_perform_query(HPWMI_SET_POWER_LIMITS_QUERY, HPWMI_GM,
+				   &limits, sizeof(limits), 0);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+
+	return count;
+}
+
+static ssize_t omenctl_kick_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct hp_wmi_hwmon_priv *priv = READ_ONCE(omenctl_priv);
+
+	if (!priv)
+		return -ENODEV;
+
+	guard(mutex)(&priv->lock);
+	priv->omenctl_last_kick = jiffies;
+	priv->omenctl_armed = true;
+	priv->omenctl_tripped = false;
+
+	return count;
+}
+
+static ssize_t omenctl_kick_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct hp_wmi_hwmon_priv *priv = READ_ONCE(omenctl_priv);
+	unsigned long since;
+
+	if (!priv)
+		return -ENODEV;
+
+	guard(mutex)(&priv->lock);
+	since = priv->omenctl_armed ?
+		jiffies_to_msecs(jiffies - priv->omenctl_last_kick) / 1000 : 0;
+
+	return sysfs_emit(buf, "armed=%d tripped=%d since_kick=%lu timeout=%u mode=%u\n",
+			  priv->omenctl_armed, priv->omenctl_tripped, since,
+			  omenctl_wd_secs(), priv->mode);
+}
