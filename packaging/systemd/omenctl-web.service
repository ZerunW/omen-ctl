[Unit]
Description=omenctl read-only system monitor (web dashboard)
Documentation=file:///usr/share/doc/omenctl/USER_GUIDE.md
After=network.target omenctld.service

[Service]
# Settings: OMENCTL_WEB_LISTEN (default 127.0.0.1:8787), OMENCTL_WEB_TOKEN_FILE.
EnvironmentFile=-/etc/omenctl/web.env
ExecStart=/usr/bin/omenctl-web
Restart=on-failure
RestartSec=5
# Unprivileged throwaway user. It reads omenctld's status through the read-only
# socket /run/omenctl-status.sock and has no access to the control socket.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: getifaddrs() (VPN addresses)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
